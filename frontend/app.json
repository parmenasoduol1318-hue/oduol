{
  "expo": {
    "name": "SwiftReply",
    "slug": "swift-reply",
    "version": "1.0.0",
    "scheme": "swiftreply",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.swiftreply.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.swiftreply.app"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-asset"
    ]
  }
}
